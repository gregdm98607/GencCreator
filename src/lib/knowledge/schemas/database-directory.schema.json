{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["databases"],
  "properties": {
    "databases": { "type": "array", "items": { "$ref": "#/$defs/database" } }
  },
  "$defs": {
    "database": {
      "type": "object",
      "required": ["id", "name", "baseUrl", "affiliateId", "utmSource", "utmMedium", "accessModel", "recordTypes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "affiliateId": { "type": "string" },
        "utmSource": { "type": "string", "minLength": 1 },
        "utmMedium": { "type": "string", "minLength": 1 },
        "accessModel": { "enum": ["free", "subscription", "pay-per-view"] },
        "recordTypes": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
