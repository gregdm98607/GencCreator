{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["strategies"],
  "properties": {
    "strategies": { "type": "array", "items": { "$ref": "#/$defs/strategy" } }
  },
  "$defs": {
    "strategy": {
      "type": "object",
      "required": ["goal", "prioritizedRecords", "description"],
      "properties": {
        "goal": { "type": "string" },
        "prioritizedRecords": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
